# ── Supabase Configuration ─────────────────────────────────────────────────
# 1. Go to https://supabase.com and create a free project
# 2. In your project dashboard, copy the URL and publishable key
# 3. Copy this file to .env and fill in your values
# 4. Run the SQL in SUPABASE_SETUP.sql in the Supabase SQL Editor
# 5. Rebuild: npm run build

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable__your-key-here
