# ── Firebase Configuration ─────────────────────────────────────────────────
# 1. Go to https://console.firebase.google.com and create a project
# 2. Build → Firestore Database → Create database (production mode)
# 3. Project settings → Your apps → Add app → Web (</>) → copy the config
# 4. Copy this file to .env and paste your values below
# 5. Deploy the security rules:  firebase deploy --only firestore:rules
# 6. Rebuild:  npm run build
#
# These values are PUBLIC by design — a Firebase web config is not a secret.
# Access is controlled by firestore.rules, not by hiding these keys.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ── Optional: App Check (recommended) ──────────────────────────────────────
# Locks the database to requests coming from this app, without any user login.
# Console → Build → App Check → register the web app with reCAPTCHA v3,
# then paste the reCAPTCHA v3 SITE key here. Leave blank to disable.
VITE_FIREBASE_APPCHECK_SITE_KEY=
